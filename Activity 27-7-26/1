from collections import Counter
corpus = [
    "I love NLP",
    "I love Python",
    "I study NLP",
    "We study Python",
    "You love NLP",
    "I study Python"
]

tokens = []
for sentence in corpus:
    tokens.extend(sentence.split())

unigram_freq = Counter(tokens)

print("Unigram Frequency")
for word, count in unigram_freq.items():
    print(f"{word} : {count}")

bigrams = []

for sentence in corpus:
    words = sentence.split()
    for i in range(len(words) - 1):
        bigrams.append((words[i], words[i + 1]))

bigram_freq = Counter(bigrams)

print("\nBigram Frequency")
for bg, count in bigram_freq.items():
    print(f"{bg[0]} {bg[1]} : {count}")
total_words = len(tokens)

print("\nUnigram Probabilities")
for word, count in unigram_freq.items():
    print(f"P({word}) = {count}/{total_words} = {count/total_words:.4f}")


print("\nBigram Probabilities (MLE)")
for bg, count in bigram_freq.items():
    first = bg[0]
    probability = count / unigram_freq[first]
    print(f"P({bg[1]} | {first}) = {count}/{unigram_freq[first]} = {probability:.4f}")

w1 = input("\nEnter first word: ")
w2 = input("Enter second word: ")

if (w1, w2) in bigram_freq:
    probability = bigram_freq[(w1, w2)] / unigram_freq[w1]
    print(f"Bigram '{w1} {w2}' exists.")
    print(f"Probability = {probability:.4f}")
else:
    print(f"Bigram '{w1} {w2}' does not exist.")
    print("Probability = 0")
