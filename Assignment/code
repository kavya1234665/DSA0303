# 15. SIMPLE WORD SENSE DISAMBIGUATION
def wsd(sentence):

    words = preprocess(sentence).split()

    auth = sum(x in words for x in
               ["login","security","authentication","credential"])

    parser = sum(x in words for x in
                 ["parser","compiler","syntax","language"])

    return "Authentication Token" if auth >= parser else "Programming Token"


print("\nWSD Example:")
print(
    wsd("The authentication token expired during login")
)


# 16. SIMPLE DISCOURSE RESOLUTION
def resolve(previous, current):

    for word in ["it","this","that","they","them"]:
        if word in current.lower().split():
            return current.lower().replace(word, previous)

    return current


print("\nDiscourse Example:")
print(
    resolve(
        "Python file handling",
        "How can I read it?"
    )
)

