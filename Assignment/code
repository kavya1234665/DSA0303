plt.show()


# 14. GRAPH 3 - QUERY CONFIDENCE
confidence = [
    answer(q)["confidence"] for q in queries
]

plt.figure(figsize=(8,4))
plt.bar(
    ["Query 1","Query 2","Query 3"],
    confidence
)
plt.title("Query Confidence Scores")
plt.xlabel("Test Query")
plt.ylabel("Cosine Similarity")
plt.ylim(0,1)
