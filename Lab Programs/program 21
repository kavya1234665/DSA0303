import spacy

nlp = spacy.load("en_core_web_sm")

sentence = "The intelligent student bought a new laptop."

doc = nlp(sentence)

print("Noun Phrases and Meanings:")

for chunk in doc.noun_chunks:
    print(chunk.text, "->", chunk.root.dep_)
