from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

documents = [
    "Machine learning is a branch of artificial intelligence",
    "Deep learning is a part of machine learning",
    "Natural language processing deals with text",
    "Artificial intelligence is used in applications"
]

query = "machine learning"

vectorizer = TfidfVectorizer()

matrix = vectorizer.fit_transform(documents + [query])

scores = cosine_similarity(matrix[-1], matrix[:-1])[0]

ranking = sorted(enumerate(scores), key=lambda x: x[1], reverse=True)

for i, score in ranking:
    print("Document", i + 1, "Score:", round(score, 3))
