import spacy

nlp = spacy.load("en_core_web_sm")

text = "Ravi went to the market. He bought a book."

doc = nlp(text)

nouns = []

for token in doc:
    if token.pos_ in ["PROPN", "NOUN"]:
        nouns.append(token.text)

for token in doc:
    if token.pos_ == "PRON":
        if nouns:
            print(token.text, "->", nouns[-1])
