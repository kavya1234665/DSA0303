grammar = {
    ("S", "NP VP"): 1.0,
    ("NP", "John"): 0.5,
    ("NP", "Mary"): 0.5,
    ("VP", "runs"): 0.6,
    ("VP", "eats"): 0.4
}

sentence = input("Enter sentence: ").split()

if len(sentence) == 2:
    subject = sentence[0]
    verb = sentence[1]

    if subject in ["John", "Mary"] and verb in ["runs", "eats"]:
        probability = grammar[("NP", subject)] * grammar[("VP", verb)]
        print("Sentence Accepted")
        print("Probability =", probability)
    else:
        print("Sentence Rejected")
else:
    print("Sentence Rejected")
